                                    </StackPanel>

                                    <!-- Band 5: 1 kHz -->
                                    <StackPanel Grid.Column="5" HorizontalAlignment="Center">
                                        <TextBlock x:Name="TxtEqDb5" Text="0" FontSize="8.5" Foreground="#8E8E93" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                        <Slider x:Name="SliderEq5" Style="{StaticResource EqVerticalSlider}" Height="66" Minimum="-12" Maximum="12" Value="0" Tag="5" ValueChanged="SliderEq_ValueChanged"/>
                                        <TextBlock Text="1k" FontSize="9" FontWeight="SemiBold" Foreground="#A1A1A6" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <!-- Band 6: 2 kHz -->
                                    <StackPanel Grid.Column="6" HorizontalAlignment="Center">
                                        <TextBlock x:Name="TxtEqDb6" Text="0" FontSize="8.5" Foreground="#8E8E93" HorizontalAlignment="Center" Margin="0,0,0,2"/>
