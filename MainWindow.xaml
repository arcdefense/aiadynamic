                                    <!-- Mode 2: Plain Lyrics Scroll Fallback -->
                                    <ScrollViewer x:Name="KaraokePlainContainer" Visibility="Collapsed" Height="78"
                                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <TextBlock x:Name="TxtKaraokePlain" Text="" Foreground="#E5E5EA" 
                                                   FontSize="12" LineHeight="18" TextWrapping="Wrap"/>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>
                            <!-- Mode C: Studio Equalizer Stage (10-Band Graphic Rack) -->
                            <Grid x:Name="EqualizerStagePanel" Visibility="Collapsed" Margin="0,0,0,4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Top Bar -->
                                <Grid Grid.Row="0" Margin="4,0,4,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/> <!-- Title -->
                                        <ColumnDefinition Width="*"/>    <!-- Preset Pills -->
                                        <ColumnDefinition Width="Auto"/> <!-- Driver Status & Bypass Buttons -->
                                    </Grid.ColumnDefinitions>

                                    <!-- Clean Compact Title -->
                                    <TextBlock Grid.Column="0" Text="🎛️ EQ" Foreground="#F2F2F7" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="2,0,6,0"/>

                                    <!-- Modern Tactile Preset Pills Switcher (Smooth Scroll for All 9 Studio Presets) -->
                                    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                                  Focusable="False" PanningMode="HorizontalOnly"
                                                  PreviewMouseWheel="PresetScrollViewer_PreviewMouseWheel"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0" MaxWidth="285">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="BtnPresetFlat" Style="{StaticResource EqPresetPillButton}" Content="Flat" Click="PresetPill_Click" Tag="Flat" ToolTip="Flat (Studio Reference)"/>
                                            <Button x:Name="BtnPresetHarman" Style="{StaticResource EqPresetPillButton}" Content="Harman" Click="PresetPill_Click" Tag="Harman Target" ToolTip="Harman Target (Audiophile Benchmark)"/>
                                            <Button x:Name="BtnPresetBass" Style="{StaticResource EqPresetPillButton}" Content="Bass" Click="PresetPill_Click" Tag="Bass Boost" ToolTip="Bass Boost (Sub-Bass Slam)"/>
                                            <Button x:Name="BtnPresetVocal" Style="{StaticResource EqPresetPillButton}" Content="Vocal" Click="PresetPill_Click" Tag="Vocal Clarity" ToolTip="Vocal Clarity (Acoustic &amp; Voice)"/>
                                            <Button x:Name="BtnPresetRock" Style="{StaticResource EqPresetPillButton}" Content="Rock" Click="PresetPill_Click" Tag="Rock / V-Shape" ToolTip="Rock / Metal (Punchy V-Shape)"/>
                                            <Button x:Name="BtnPresetPop" Style="{StaticResource EqPresetPillButton}" Content="Pop" Click="PresetPill_Click" Tag="Pop / Modern" ToolTip="Pop / Modern (Radio Ready)"/>
                                            <Button x:Name="BtnPresetEdm" Style="{StaticResource EqPresetPillButton}" Content="EDM" Click="PresetPill_Click" Tag="Electronic / EDM" ToolTip="Electronic / EDM (Club &amp; Dance)"/>
                                            <Button x:Name="BtnPresetJazz" Style="{StaticResource EqPresetPillButton}" Content="Jazz" Click="PresetPill_Click" Tag="Jazz / Acoustic" ToolTip="Jazz / Acoustic (Warm &amp; Natural)"/>
                                            <Button x:Name="BtnPresetClassical" Style="{StaticResource EqPresetPillButton}" Content="Classic" Click="PresetPill_Click" Tag="Classical / Hall" ToolTip="Classical / Hall (Symphonic Stage)"/>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <!-- Right: Driver Status Pill + Bypass Toggle Button -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="BtnEqDriverHelp" Height="22" Margin="0,0,5,0" Padding="6,0" Cursor="Hand"
