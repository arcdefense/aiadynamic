                                    <StackPanel x:Name="KaraokeSyncContainer" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtKaraokeTrackHeader" Text="Music Karaoke" 
                                                   Foreground="#636366" FontSize="10" FontWeight="SemiBold" 
                                                   Margin="0,0,0,3" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="TxtKaraokePrev" Text="" 
                                                   Foreground="#48484A" FontSize="11" Margin="0,0,0,2" 
                                                   TextTrimming="CharacterEllipsis" Cursor="Hand"
                                                   MouseLeftButtonUp="TxtKaraokePrev_MouseLeftButtonUp"
                                                   ToolTip="Klik untuk lompat ke lirik sebelumnya (Seek)"/>
                                        <TextBlock x:Name="TxtKaraokeCurrent" Text="🎵 Mengambil lirik lagu..." 
                                                   Foreground="#30D158" FontSize="15" FontWeight="Bold" 
                                                   TextWrapping="Wrap" MaxHeight="46" LineHeight="20" Margin="0,1,0,3"
                                                   Cursor="Hand" MouseLeftButtonUp="TxtKaraokeCurrent_MouseLeftButtonUp"
                                                   ToolTip="Klik untuk mengulang baris lirik ini">
                                            <TextBlock.Effect>
                                                <DropShadowEffect x:Name="CurrentLyricGlow" Color="#30D158" BlurRadius="12" Opacity="0.5" ShadowDepth="0"/>
                                            </TextBlock.Effect>
                                        </TextBlock>
                                        <TextBlock x:Name="TxtKaraokeNext" Text="" 
                                                   Foreground="#E5E5EA" FontSize="11" Opacity="0.5"
                                                   TextTrimming="CharacterEllipsis" Cursor="Hand"
                                                   MouseLeftButtonUp="TxtKaraokeNext_MouseLeftButtonUp"
                                                   ToolTip="Klik untuk lompat ke lirik berikutnya (Seek)"/>
