                                            <TextBlock x:Name="TxtEqBypass" Text="ON" FontSize="9.5" FontWeight="Bold" Foreground="#30D158" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Fader Rack: 10 ISO Bands + 1 Preamp -->
                                <Grid Grid.Row="1" HorizontalAlignment="Center" Width="430">
