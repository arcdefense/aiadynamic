                                            Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,0,2">
                                    <Rectangle x:Name="ExpBar1" Width="5.5" Height="3" Fill="#30D158" RadiusX="2.5" RadiusY="2.5" Margin="1.8,0" VerticalAlignment="Bottom"/>
                                    <Rectangle x:Name="ExpBar2" Width="5.5" Height="3" Fill="#30D158" RadiusX="2.5" RadiusY="2.5" Margin="1.8,0" VerticalAlignment="Bottom"/>
                                    <Rectangle x:Name="ExpBar3" Width="5.5" Height="3" Fill="#30D158" RadiusX="2.5" RadiusY="2.5" Margin="1.8,0" VerticalAlignment="Bottom"/>
                                    <Rectangle x:Name="ExpBar4" Width="5.5" Height="3" Fill="#30D158" RadiusX="2.5" RadiusY="2.5" Margin="1.8,0" VerticalAlignment="Bottom"/>
                                    <Rectangle x:Name="ExpBar5" Width="5.5" Height="3" Fill="#30D158" RadiusX="2.5" RadiusY="2.5" Margin="1.8,0" VerticalAlignment="Bottom"/>
                                    <Rectangle x:Name="ExpBar6" Width="5.5" Height="3" Fill="#30D158" RadiusX="2.5" RadiusY="2.5" Margin="1.8,0" VerticalAlignment="Bottom"/>
                                    <Rectangle x:Name="ExpBar7" Width="5.5" Height="3" Fill="#30D158" RadiusX="2.5" RadiusY="2.5" Margin="1.8,0" VerticalAlignment="Bottom"/>
                                    <Rectangle x:Name="ExpBar8" Width="5.5" Height="3" Fill="#30D158" RadiusX="2.5" RadiusY="2.5" Margin="1.8,0" VerticalAlignment="Bottom"/>
                                    <Rectangle x:Name="ExpBar9" Width="5.5" Height="3" Fill="#30D158" RadiusX="2.5" RadiusY="2.5" Margin="1.8,0" VerticalAlignment="Bottom"/>
                                    <Rectangle x:Name="ExpBar10" Width="5.5" Height="3" Fill="#30D158" RadiusX="2.5" RadiusY="2.5" Margin="1.8,0" VerticalAlignment="Bottom"/>
                                    <Rectangle x:Name="ExpBar11" Width="5.5" Height="3" Fill="#30D158" RadiusX="2.5" RadiusY="2.5" Margin="1.8,0" VerticalAlignment="Bottom"/>
                                    <Rectangle x:Name="ExpBar12" Width="5.5" Height="3" Fill="#30D158" RadiusX="2.5" RadiusY="2.5" Margin="1.8,0" VerticalAlignment="Bottom"/>
                                    <Rectangle x:Name="ExpBar13" Width="5.5" Height="3" Fill="#30D158" RadiusX="2.5" RadiusY="2.5" Margin="1.8,0" VerticalAlignment="Bottom"/>
                                    <Rectangle x:Name="ExpBar14" Width="5.5" Height="3" Fill="#30D158" RadiusX="2.5" RadiusY="2.5" Margin="1.8,0" VerticalAlignment="Bottom"/>
                                    <Rectangle x:Name="ExpBar15" Width="5.5" Height="3" Fill="#30D158" RadiusX="2.5" RadiusY="2.5" Margin="1.8,0" VerticalAlignment="Bottom"/>
                                    <Rectangle x:Name="ExpBar16" Width="5.5" Height="3" Fill="#30D158" RadiusX="2.5" RadiusY="2.5" Margin="1.8,0" VerticalAlignment="Bottom"/>
                                    <Rectangle x:Name="ExpBar17" Width="5.5" Height="3" Fill="#30D158" RadiusX="2.5" RadiusY="2.5" Margin="1.8,0" VerticalAlignment="Bottom"/>
                                    <Rectangle x:Name="ExpBar18" Width="5.5" Height="3" Fill="#30D158" RadiusX="2.5" RadiusY="2.5" Margin="1.8,0" VerticalAlignment="Bottom"/>
                                    <Rectangle x:Name="ExpBar19" Width="5.5" Height="3" Fill="#30D158" RadiusX="2.5" RadiusY="2.5" Margin="1.8,0" VerticalAlignment="Bottom"/>
                                    <Rectangle x:Name="ExpBar20" Width="5.5" Height="3" Fill="#30D158" RadiusX="2.5" RadiusY="2.5" Margin="1.8,0" VerticalAlignment="Bottom"/>
                                </StackPanel>
