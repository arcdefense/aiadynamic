                                </Grid.ColumnDefinitions>

                                <!-- Column 0: Album Art (Vinyl Record Style) -->
                                <Border Grid.Column="0" Width="62" Height="62" CornerRadius="31" 
                                        Background="#1A1A1E" BorderBrush="#333338" BorderThickness="1.5"
                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Border.Clip>
                                        <RectangleGeometry Rect="0,0,62,62" RadiusX="31" RadiusY="31"/>
                                    </Border.Clip>
                                    <Grid>
                                        <!-- Placeholder when no art -->
                                        <Path Width="26" Height="26" Fill="#3A3A3C" Stretch="Uniform"
                                              Data="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/>
                                        <Image x:Name="ExpandedAlbumArt" Stretch="UniformToFill" RenderTransformOrigin="0.5,0.5">
                                            <Image.RenderTransform>
                                                <RotateTransform x:Name="ExpandedVinylRotate" Angle="0"/>
                                            </Image.RenderTransform>
                                        </Image>
