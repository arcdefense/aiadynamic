                                        <Ellipse Width="10" Height="10" Fill="#0D0D0E" Stroke="#333338" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <!-- Column 1: Track Info (Compact, allowing spectrum to meet title) -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,8,0">
                                    <TextBlock x:Name="TxtExpandedTitle" Text="Nothing Playing" 
                                               Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" 
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="TxtExpandedArtist" Text="Start Spotify or Chrome to play music" 
                                               Foreground="#8E8E93" FontSize="11" Margin="0,3,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="TxtExpandedAlbum" Text="" 
                                               Foreground="#636366" FontSize="10" Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <!-- Column 2: 20-Band Pro Equalizer Audio Spectrum (Punchy & Proportional) -->
