<Window x:Class="DynamicIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aia Dinamic"
        Height="360" Width="1600"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Transparent RepeatButton for Vertical Slider Track Bounds -->
        <Style x:Key="SliderRepeatButtonTransparent" TargetType="{x:Type RepeatButton}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Rectangle Fill="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Studio Equalizer Vertical Slider Style with Working Tactile Fader Knob -->
        <Style x:Key="EqVerticalSlider" TargetType="{x:Type Slider}">
            <Setter Property="Orientation" Value="Vertical"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="AutoToolTipPlacement" Value="None"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid Width="26" HorizontalAlignment="Center">
                            <!-- Track Groove -->
                            <Border Width="4" Background="#28282D" CornerRadius="2"
                                    HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
                            <!-- 0 dB Center Mark Line -->
                            <Rectangle Height="1.5" Width="10" Fill="#48484A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsDirectionReversed="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Style="{StaticResource SliderRepeatButtonTransparent}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="20" Height="11" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border x:Name="thumbBorder" Width="20" Height="11" 
                                                        Background="#F2F2F7" CornerRadius="3"
                                                        BorderBrush="#1C1C1E" BorderThickness="1">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.5"/>
                                                    </Border.Effect>
                                                    <Rectangle Width="8" Height="1.5" Fill="#8E8E93" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="thumbBorder" Property="Background" Value="#30D158"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="thumbBorder" Property="Background" Value="#30D158"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Style="{StaticResource SliderRepeatButtonTransparent}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Quick Preset Pill Button Style -->
        <Style x:Key="EqPresetPillButton" TargetType="Button">
            <Setter Property="Background" Value="#1C1C1E"/>
            <Setter Property="Foreground" Value="#8E8E93"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="pillBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#2C2C2E" BorderThickness="1"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="pillBorder" Property="Background" Value="#2C2C2E"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.ContextMenu>
        <ContextMenu x:Name="RootContextMenu" Opened="ContextMenu_Opened" Closed="ContextMenu_Closed">
            <!-- GROUP 1: PERILAKU NOTCH -->
            <MenuItem Header="📌 Pin / Pertahankan Terbuka" IsCheckable="True" x:Name="MenuItemPin" Click="MenuItemPin_Click"/>
            <MenuItem Header="⚡ Sembunyi Otomatis (Auto-Hide)" IsCheckable="True" IsChecked="True" x:Name="MenuItemAutoHide" Click="MenuItemAutoHide_Click"/>
            <MenuItem Header="📶 Kecepatan Jaringan (TX/RX)" x:Name="MenuSpeedMeterRoot">
                <MenuItem Header="⚡ Tampilkan Speed Meter" IsCheckable="True" x:Name="MenuItemSpeedMeter" Click="MenuItemSpeedMeter_Click"/>
                <Separator/>
                <MenuItem Header="📦 Satuan: Byte/s (KB/s, MB/s)" Tag="Bytes" x:Name="MenuSpeedUnitBytes" IsCheckable="True" Click="MenuSpeedUnit_Click"/>
                <MenuItem Header="🌐 Satuan: bit/s (kbps, Mbps)" Tag="Bits" x:Name="MenuSpeedUnitBits" IsCheckable="True" Click="MenuSpeedUnit_Click"/>
            </MenuItem>
            <MenuItem Header="🖥️ Posisi Layar (Monitor)" x:Name="MenuMonitorSelect"/>

            <Separator/>

            <!-- GROUP 2: TAMPILAN & FITUR -->
            <MenuItem Header="📱 Model Dock Pintasan" x:Name="MenuDockMode">
                <MenuItem Header="🏷️ Model 1: Sejajar di Kapsul" Tag="Inline" Click="MenuDockMode_Click" IsCheckable="True"/>
                <MenuItem Header="🪟 Model 2: Tombol Grid Minimalis (⊞)" Tag="GridButton" Click="MenuDockMode_Click" IsCheckable="True"/>
                <Separator/>
                <MenuItem Header="🚫 Sembunyikan Dock" Tag="Hidden" Click="MenuDockMode_Click" IsCheckable="True"/>
            </MenuItem>
            <MenuItem Header="💬 Lirik Musik Mengambang" x:Name="MenuLyricsStyle">
                <MenuItem Header="📱 Notch Kapsul (Modern)" x:Name="MenuItemLyricStyleNotch" IsCheckable="True" Click="MenuItemLyricStyleNotch_Click"/>
                <MenuItem Header="🪟 Teks Melayang Polos (HUD)" x:Name="MenuItemLyricStylePlain" IsCheckable="True" Click="MenuItemLyricStylePlain_Click"/>
                <Separator/>
                <MenuItem Header="🔤 Ukuran Teks Lirik" x:Name="MenuLyricFontSizeRoot">
                    <MenuItem Header="Kecil (12pt)" x:Name="MenuLyricSize12" IsCheckable="True" Click="MenuLyricSize_Click" Tag="12"/>
                    <MenuItem Header="Standar (16pt)" x:Name="MenuLyricSize16" IsCheckable="True" Click="MenuLyricSize_Click" Tag="16"/>
                    <MenuItem Header="Sedang (20pt)" x:Name="MenuLyricSize20" IsCheckable="True" Click="MenuLyricSize_Click" Tag="20"/>
                    <MenuItem Header="Besar (28pt)" x:Name="MenuLyricSize28" IsCheckable="True" Click="MenuLyricSize_Click" Tag="28"/>
                    <MenuItem Header="Ekstra Besar (38pt)" x:Name="MenuLyricSize38" IsCheckable="True" Click="MenuLyricSize_Click" Tag="38"/>
                    <MenuItem Header="Jumbo (52pt)" x:Name="MenuLyricSize52" IsCheckable="True" Click="MenuLyricSize_Click" Tag="52"/>
                    <MenuItem Header="🌟 Maksimal (72pt)" x:Name="MenuLyricSize72" IsCheckable="True" Click="MenuLyricSize_Click" Tag="72"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="📜 Gulir 2 Baris (Baris Aktif + Pratinjau)" x:Name="MenuItemLyricTwoLines" IsCheckable="True" Click="MenuItemLyricTwoLines_Click"/>
                <MenuItem Header="📝 1 Baris Saja (Minimalis)" x:Name="MenuItemLyricSingleLine" IsCheckable="True" Click="MenuItemLyricSingleLine_Click"/>
                <Separator/>
                <MenuItem Header="🎚️ Opasitas Pratinjau" x:Name="MenuLyricOpacityRoot">
                    <MenuItem Header="35% (Sangat Halus)" x:Name="MenuLyricOpacity35" IsCheckable="True" Click="MenuItemLyricOpacity_Click" Tag="0.35"/>
                    <MenuItem Header="50% (Standar)" x:Name="MenuLyricOpacity50" IsCheckable="True" Click="MenuItemLyricOpacity_Click" Tag="0.50"/>
                    <MenuItem Header="70% (Tegas)" x:Name="MenuLyricOpacity70" IsCheckable="True" Click="MenuItemLyricOpacity_Click" Tag="0.70"/>
                    <MenuItem Header="100% (Penuh / Jelas)" x:Name="MenuLyricOpacity100" IsCheckable="True" Click="MenuItemLyricOpacity_Click" Tag="1.00"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="🎨 Tema Warna Spektrum" x:Name="MenuSpectrumTheme">
                <MenuItem Header="🟢 Neo Green (Default)" x:Name="MenuThemeNeoGreen" IsCheckable="True" Click="MenuColor_NeoGreen"/>
                <MenuItem Header="🌈 Rainbow Spectrum" x:Name="MenuThemeRainbow" IsCheckable="True" Click="MenuColor_Rainbow"/>
                <MenuItem Header="🔵 Cyber Cyan" x:Name="MenuThemeCyberBlue" IsCheckable="True" Click="MenuColor_CyberBlue"/>
                <MenuItem Header="💜 Tokyo Neon" x:Name="MenuThemeTokyoNeon" IsCheckable="True" Click="MenuColor_TokyoNeon"/>
                <MenuItem Header="🔥 Crimson Red" x:Name="MenuThemeCrimsonFire" IsCheckable="True" Click="MenuColor_CrimsonFire"/>
                <MenuItem Header="🌊 Deep Ocean" x:Name="MenuThemeDeepOcean" IsCheckable="True" Click="MenuColor_DeepOcean"/>
                <MenuItem Header="✨ Champagne Gold" x:Name="MenuThemeChampagneGold" IsCheckable="True" Click="MenuColor_ChampagneGold"/>
                <MenuItem Header="🌸 Sakura Pink" x:Name="MenuThemeSakuraPink" IsCheckable="True" Click="MenuColor_SakuraPink"/>
                <MenuItem Header="⚪ Minimalist White" x:Name="MenuThemeWhite" IsCheckable="True" Click="MenuColor_White"/>
                <MenuItem Header="🟠 Sunset Amber" x:Name="MenuThemeSunset" IsCheckable="True" Click="MenuColor_Sunset"/>
            </MenuItem>
            <MenuItem Header="📊 Model Bentuk Spektrum" x:Name="MenuSpectrumModel">
                <MenuItem Header="📊 Model 1: Batang Bawah (Bottom-Up) [Klasik]" x:Name="MenuModelBottomUp" IsCheckable="True" Click="MenuModel_BottomUp"/>
                <MenuItem Header="📱 Model 2: Simetris Tengah (Center-Mirrored) [Dynamic Island]" x:Name="MenuModelCenterMirrored" IsCheckable="True" Click="MenuModel_CenterMirrored"/>
                <MenuItem Header="🔻 Model 3: Gantung Bezel (Top-Down) [Stalaktit]" x:Name="MenuModelTopDown" IsCheckable="True" Click="MenuModel_TopDown"/>
                <MenuItem Header="⚡ Model 4: Jarum Minimalis (Cyber Needles)" x:Name="MenuModelNeedles" IsCheckable="True" Click="MenuModel_Needles"/>
                <MenuItem Header="🫧 Model 5: Butiran Melompat (Bouncing Beads)" x:Name="MenuModelBouncingBeads" IsCheckable="True" Click="MenuModel_BouncingBeads"/>
                <MenuItem Header="🪟 Model 6: Blok Bertingkat (Retro Digital VU)" x:Name="MenuModelSegmentedVU" IsCheckable="True" Click="MenuModel_SegmentedVU"/>
                <MenuItem Header="🧱 Model 7: Batang Tebal DJ Studio (Chunky Club Bars)" x:Name="MenuModelChunkyBars" IsCheckable="True" Click="MenuModel_ChunkyBars"/>
            </MenuItem>
            <MenuItem Header="🎛️ Equalizer &amp; Audio" x:Name="MenuEqualizerRoot">
                <MenuItem Header="🎚️ Buka Equalizer Stage" Click="MenuItemEqualizer_Click"/>
                <MenuItem Header="⚡ Equalizer Aktif (ON)" x:Name="MenuItemEqEnabled" IsCheckable="True" Click="MenuItemEqToggle_Click"/>
                <Separator/>
                <MenuItem Header="🎵 Pilihan Preset Studio" x:Name="MenuEqPresets">
                    <MenuItem Header="Flat (Studio Reference)" Click="MenuPreset_Click" Tag="Flat" IsCheckable="True"/>
                    <MenuItem Header="Harman Curve (Audiophile Target)" Click="MenuPreset_Click" Tag="Harman Target" IsCheckable="True"/>
                    <MenuItem Header="Bass Boost (Sub-Bass Slam)" Click="MenuPreset_Click" Tag="Bass Boost" IsCheckable="True"/>
                    <MenuItem Header="Vocal Clarity (Acoustic &amp; Voice)" Click="MenuPreset_Click" Tag="Vocal Clarity" IsCheckable="True"/>
                    <MenuItem Header="Rock / Metal (Punchy V-Shape)" Click="MenuPreset_Click" Tag="Rock / V-Shape" IsCheckable="True"/>
                    <MenuItem Header="Pop / Modern (Radio Ready)" Click="MenuPreset_Click" Tag="Pop / Modern" IsCheckable="True"/>
                    <MenuItem Header="Electronic / EDM (Club Dance)" Click="MenuPreset_Click" Tag="Electronic / EDM" IsCheckable="True"/>
                    <MenuItem Header="Jazz / Acoustic (Warm &amp; Natural)" Click="MenuPreset_Click" Tag="Jazz / Acoustic" IsCheckable="True"/>
                    <MenuItem Header="Classical / Hall (Symphonic Stage)" Click="MenuPreset_Click" Tag="Classical / Hall" IsCheckable="True"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="🎚️ Sensitivitas Audio" x:Name="MenuAudioSens">
                    <MenuItem Header="Normal (1.0x)" x:Name="MenuSens10" IsCheckable="True" Click="MenuSens_Normal"/>
                    <MenuItem Header="High (1.5x)" x:Name="MenuSens15" IsCheckable="True" Click="MenuSens_High"/>
                    <MenuItem Header="Ultra Boost (2.0x)" x:Name="MenuSens20" IsCheckable="True" Click="MenuSens_Boost"/>
                </MenuItem>
                <MenuItem Header="🔄 Sambung Ulang Spektrum Audio" Click="MenuRestartAudioSpectrum_Click"/>
                <MenuItem Header="ℹ️ Format: Mendeteksi..." x:Name="MenuAudioFormatInfo" IsEnabled="False"/>
            </MenuItem>

            <Separator/>

            <!-- GROUP 3: KONTROL PEMUTAR MEDIA -->
            <MenuItem Header="🎵 Kontrol Pemutar Media">
                <MenuItem Header="⏯ Putar / Jeda" Click="BtnPlayPause_Click"/>
                <MenuItem Header="⏮ Lagu Sebelumnya" Click="BtnPrev_Click"/>
                <MenuItem Header="⏭ Lagu Berikutnya" Click="BtnNext_Click"/>
                <Separator/>
                <MenuItem Header="🔈 Senyapkan Suara (Mute)" Click="BtnMute_Click"/>
                <MenuItem Header="🔄 Segarkan Status Media" Click="MenuItemRefresh_Click"/>
            </MenuItem>

            <Separator/>

            <!-- GROUP 4: SISTEM & APLIKASI -->
            <MenuItem Header="🚀 Jalankan saat Windows Mulai" IsCheckable="True" x:Name="MenuItemStartup" Click="MenuItemStartup_Click"/>
            <Separator/>
            <MenuItem Header="❌ Keluar dari Aia Dinamic" Click="MenuItemExit_Click"/>
        </ContextMenu>
    </Window.ContextMenu>

    <!-- Main Container -->
    <Grid HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,0,0,0">
        
        <!-- Authentic MacBook Pro Notch Background Path -->
        <Path x:Name="NotchShapePath"
              HorizontalAlignment="Center" VerticalAlignment="Top"
              Fill="#0C0C0E"
              Stroke="#2A2A2E"
              StrokeThickness="1"
              SnapsToDevicePixels="True"
              IsHitTestVisible="False">
            <Path.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.55"/>
            </Path.Effect>
        </Path>

        <!-- The Notch Content Container (Docked to Top Bezel) -->
        <Border x:Name="IslandBorder"
                Width="188"
                Height="40"
                Background="Transparent"
                BorderThickness="0"
                SizeChanged="IslandBorder_SizeChanged"
                SnapsToDevicePixels="True"
                Cursor="Hand"
                AllowDrop="True"
                DragEnter="IslandBorder_DragEnter"
                DragOver="IslandBorder_DragOver"
                DragLeave="IslandBorder_DragLeave"
                Drop="IslandBorder_Drop"
                MouseEnter="IslandBorder_MouseEnter"
                MouseLeave="IslandBorder_MouseLeave"
                PreviewMouseLeftButtonDown="IslandBorder_PreviewMouseLeftButtonDown"
                PreviewMouseWheel="IslandBorder_PreviewMouseWheel">

            <Grid ClipToBounds="True" Background="Transparent">

                <!-- Drag & Drop Visual Hint Overlay -->
                <Border x:Name="DropOverlay" Background="#E60D0D0E" CornerRadius="18" Visibility="Collapsed"
                        BorderBrush="#30D158" BorderThickness="1.5" SnapsToDevicePixels="True" Panel.ZIndex="999">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="📥" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Lepaskan untuk Pin ke Dock" Foreground="#30D158" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <!-- ==================== 1. COMPACT / IDLE MODE ==================== -->
                <!-- Layout: [Spektrum (Kiri)] - [Jam & Tanggal (Tengah)] - [Speed Meter TX/RX (Fixed 64px)] - [Dock + Grid ⊞ (Kanan)] -->
                <Grid x:Name="CompactView" VerticalAlignment="Center" Margin="8,0" Opacity="1">
                    <Grid.ColumnDefinitions>
                        <!-- Column 0: Fixed Width 32px Spektrum Slot -->
                        <ColumnDefinition Width="32"/>
                        <!-- Column 1: Flexible center column for Clock (Dead-Center & Locked) -->
                        <ColumnDefinition Width="*"/>
                        <!-- Column 2: Real-time TX/RX Network Speed Meter (Fixed 64px Width - Zero Jitter) -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Column 3: Dock Shortcuts + Grid Drawer Button -->
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Real-time Audio Spectrum Equalizer (Dedicated 32px balance slot) -->
                    <Grid Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left" Width="32">
                        <StackPanel x:Name="EqualizerPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,6,0">
                            <Rectangle x:Name="EqBar1" Width="3" Height="2" Fill="#3A3A3E" RadiusX="1" RadiusY="1" Margin="1,0"/>
                            <Rectangle x:Name="EqBar2" Width="3" Height="2" Fill="#3A3A3E" RadiusX="1" RadiusY="1" Margin="1,0"/>
                            <Rectangle x:Name="EqBar3" Width="3" Height="2" Fill="#3A3A3E" RadiusX="1" RadiusY="1" Margin="1,0"/>
                            <Rectangle x:Name="EqBar4" Width="3" Height="2" Fill="#3A3A3E" RadiusX="1" RadiusY="1" Margin="1,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Center: Digital Clock + Day & Date -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Margin="4,0">
                        <TextBlock x:Name="TxtCompactTime" Text="12:00" Foreground="#FFFFFF" 
                                   FontWeight="Bold" FontSize="13.5" HorizontalAlignment="Center" Margin="0,0,0,1"/>
                        <TextBlock x:Name="TxtCompactDate" Text="Kamis, 22 Okt" Foreground="#8E8E93" 
                                   FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Center-Right: Real-time TX/RX Network Speed Meter (Fixed 64px width - Zero Jitter) -->
                    <!-- Download on top (↓), Upload on bottom (↑), monochromatic clock style -->
                    <Grid x:Name="NetworkSpeedPanel" Grid.Column="2" Width="64" VerticalAlignment="Center" HorizontalAlignment="Center"
                          Visibility="Collapsed" IsHitTestVisible="False" Margin="6,0,8,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Top Row: Download (RX) -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="↓" FontSize="9" Foreground="#8E8E93" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" x:Name="TxtSpeedDownload" Text="0 B/s" FontSize="9" Foreground="#FFFFFF" FontWeight="SemiBold" 
                                       TextAlignment="Left" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                        </Grid>

                        <!-- Bottom Row: Upload (TX) -->
                        <Grid Grid.Row="1" Margin="0,1.5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="↑" FontSize="9" Foreground="#8E8E93" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" x:Name="TxtSpeedUpload" Text="0 B/s" FontSize="9" Foreground="#8E8E93" FontWeight="SemiBold" 
                                       TextAlignment="Left" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                        </Grid>
                    </Grid>

                    <!-- Right: App Shortcuts Shelf & Grid Button (⊞) -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,2,0">
                        <!-- App Shortcuts (Smoothly revealed when ⊞ is clicked) -->
                        <ItemsControl x:Name="DockInlineList" Visibility="Collapsed" Margin="0,0,6,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="26" Height="26" Margin="1,0" Background="Transparent" CornerRadius="6"
                                            Cursor="Hand" ToolTip="{Binding Name}" Tag="{Binding}"
                                            PreviewMouseLeftButtonDown="DockItem_PreviewMouseLeftButtonDown"
                                            MouseLeftButtonUp="DockItem_MouseLeftButtonUp"
                                            MouseRightButtonUp="DockItem_MouseRightButtonUp">
                                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Image Source="{Binding IconSource}" Width="18" Height="18" VerticalAlignment="Top"/>
                                            <Ellipse Width="3" Height="3" Fill="#30D158" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                                     Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisConverter}}" Margin="0,0,0,1"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Minimalist ⊞ Grid Button -->
                        <Border x:Name="BtnGridDrawer" Width="22" Height="22" CornerRadius="6" Background="#1C1C1E"
                                Cursor="Hand" ToolTip="Pintasan Aplikasi (⊞)"
                                PreviewMouseLeftButtonDown="BtnGridDrawer_Click" Visibility="Visible">
                            <Path x:Name="GridDrawerIcon" Data="M3 3h6v6H3V3zm10 0h6v6h-6V3zM3 13h6v6H3v-6zm10 0h6v6h-6v-6z"
                                  Fill="#8E8E93" Stretch="Uniform" Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- Hidden bindings to preserve code-behind references safely -->
                    <Grid Visibility="Collapsed">
                        <Border x:Name="MiniThumbBorder">
                            <Image x:Name="MiniThumbImage">
                                <Image.RenderTransform>
                                    <RotateTransform x:Name="MiniVinylRotate" Angle="0"/>
                                </Image.RenderTransform>
                            </Image>
                        </Border>
                        <Path x:Name="CompactIcon"/>
                        <TextBlock x:Name="TxtCompactTitle"/>
                        <Border x:Name="StatusDot">
                            <Border.ToolTip>
                                <ToolTip x:Name="BatteryToolTip" Content="Status: OK"/>
                            </Border.ToolTip>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ==================== 2. EXPANDED MODE ==================== -->
                <Grid x:Name="ExpandedView" Margin="16,12" Opacity="0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header Row: App Tag & Status + Center Segmented Tabs -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: App Tag & Battery -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtAppSource" Text="SPOTIFY" Foreground="#F2F2F7" 
                                       FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="•" Foreground="#545458" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtExpandedBattery" Text="100% ⚡" Foreground="#8E8E93" 
                                       FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Center: Segmented Navigation Tab Switcher -->
                        <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Background="#18181B" CornerRadius="12" Padding="2" BorderBrush="#2C2C2E" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <!-- Tab 1: Musik / Player -->
                                <Border x:Name="TabBtnPlayer" CornerRadius="10" Background="#2C2C2E" Cursor="Hand" Padding="9,3.5" Margin="1,0"
                                        MouseLeftButtonUp="TabBtnPlayer_Click" ToolTip="Tampilan Pemutar Musik">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🎵" FontSize="10.5" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtTabPlayer" Text="Musik" Foreground="#FFFFFF" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <!-- Tab 2: Pintasan Aplikasi (Dock) -->
