                                        <TextBlock x:Name="TxtEqDbPreamp" Text="0" FontSize="8.5" Foreground="#FF9F0A" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                        <Slider x:Name="SliderEqPreamp" Style="{StaticResource EqVerticalSlider}" Height="66" Minimum="-12" Maximum="0" Value="0" ValueChanged="SliderEqPreamp_ValueChanged"/>
                                        <TextBlock Text="PRE" FontSize="9" FontWeight="Bold" Foreground="#FF9F0A" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Grid>

                        <!-- Bottom Row: Media Controls, Lyrics Toggle & Volume -->
                        <Grid Grid.Row="1">
                            <!-- Far Left: Official Lyrics Button (Tangga Lagu / Double Music Notes) -->
                            <Button x:Name="BtnLyrics" Style="{StaticResource IslandIconButton}" Width="32" Height="32" 
                                    HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0" 
                                    Click="BtnLyrics_Click" ToolTip="Lirik Mengambang (Karaoke)">
                                <Path x:Name="MicIcon" Width="14" Height="14" Fill="#8E8E93" Stretch="Uniform"
                                      Data="M10 4v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V8h8v6.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V4H10z"/>
                            </Button>

                            <!-- Playback Controls -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <!-- Prev -->
                                <Button Style="{StaticResource IslandIconButton}" Width="36" Height="36" 
                                        Margin="4,0" Click="BtnPrev_Click" ToolTip="Previous Track">
                                    <Path Width="13" Height="13" Fill="#F2F2F7" Stretch="Uniform"
                                          Data="M6 6h2v12H6zm3.5 6l8.5 6V6z"/>
                                </Button>

                                <!-- Play / Pause -->
                                <Button x:Name="BtnPlayPause" Style="{StaticResource IslandIconButton}" Width="42" Height="42" 
                                        Background="#F2F2F7" Margin="6,0" Click="BtnPlayPause_Click" ToolTip="Play / Pause">
                                    <Path x:Name="PlayPauseIcon" Width="16" Height="16" Fill="#000000" Stretch="Uniform"
                                          Data="M8 5v14l11-7z"/>
                                </Button>

                                <!-- Next -->
                                <Button Style="{StaticResource IslandIconButton}" Width="36" Height="36" 
                                        Margin="4,0" Click="BtnNext_Click" ToolTip="Next Track">
                                    <Path Width="13" Height="13" Fill="#F2F2F7" Stretch="Uniform"
                                          Data="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z"/>
                                </Button>
                            </StackPanel>

                            <!-- Quick Volume Buttons (Right aligned) -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                <!-- Tombol EQ di pinggir icon speaker - -->
                                <Button x:Name="BtnEqToggle" Style="{StaticResource IslandIconButton}" Width="28" Height="28" 
                                        Padding="4" Margin="2,0" Click="BtnEqToggle_Click" ToolTip="Studio Equalizer">
                                    <Path x:Name="EqIcon" Width="11" Height="11" Fill="#8E8E93" Stretch="Uniform"
                                          Data="M3 17v2h6v-2H3zM3 5v2h10V5H3zm10 16v-2h8v-2h-8v-2h-2v6h2zM7 9v2H3v2h4v2h2V9H7zm14 4v-2H11v2h10zm-6-4h2V7h4V5h-4V3h-2v6z"/>
                                </Button>
                                <Button Style="{StaticResource IslandIconButton}" Width="28" Height="28" 
                                        Padding="4" Margin="2,0" Click="BtnVolDown_Click" ToolTip="Volume Down">
                                    <Path Width="10" Height="10" Fill="#8E8E93" Stretch="Uniform"
                                          Data="M18.5 12c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM5 9v6h4l5 5V4L9 9H5z"/>
                                </Button>
                                <Button Style="{StaticResource IslandIconButton}" Width="28" Height="28" 
                                        Padding="4" Margin="2,0" Click="BtnVolUp_Click" ToolTip="Volume Up">
                                    <Path Width="10" Height="10" Fill="#8E8E93" Stretch="Uniform"
                                          Data="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- ==================== SYSTEM DASHBOARD PANEL (Shown when _hasMedia is FALSE) ==================== -->
                    <Grid x:Name="SystemDashboardPanel" Grid.Row="1" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="175"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Digital Clock & Date -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="2,0,10,0">
                            <TextBlock x:Name="TxtDashboardTime" Text="12:00" Foreground="#FFFFFF" 
                                       FontSize="30" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtDashboardDate" Text="Kamis, 22 Oktober" Foreground="#8E8E93" 
                                       FontSize="11.5" FontWeight="SemiBold" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Right: Performance Bars -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <!-- CPU Row -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="34"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="CPU" Foreground="#8E8E93" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Height="5" CornerRadius="2.5" Background="#2C2C2E" VerticalAlignment="Center" Margin="4,0">
                                    <Border x:Name="CpuMeterBar" HorizontalAlignment="Left" Width="30" CornerRadius="2.5" Background="#30D158"/>
                                </Border>
                                <TextBlock x:Name="TxtDashboardCpu" Text="0%" Foreground="#F2F2F7" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Column="2"/>
                            </Grid>

                            <!-- RAM Row -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="34"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="RAM" Foreground="#8E8E93" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Height="5" CornerRadius="2.5" Background="#2C2C2E" VerticalAlignment="Center" Margin="4,0">
                                    <Border x:Name="RamMeterBar" HorizontalAlignment="Left" Width="60" CornerRadius="2.5" Background="#0A84FF"/>
                                </Border>
                                <TextBlock x:Name="TxtDashboardRam" Text="0%" Foreground="#F2F2F7" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Column="2"/>
                            </Grid>

                            <!-- Volume Row -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="34"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="VOL" Foreground="#8E8E93" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Height="5" CornerRadius="2.5" Background="#2C2C2E" VerticalAlignment="Center" Margin="4,0">
                                    <Border x:Name="VolumeMeterBar" HorizontalAlignment="Left" Width="55" CornerRadius="2.5" Background="#FF9F0A"/>
                                </Border>
                                <TextBlock x:Name="TxtDashboardVol" Text="0%" Foreground="#F2F2F7" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Column="2"/>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- 3. App Dock Drawer (Shown when user opens Dock from Header or Grid Button) -->
                    <Grid x:Name="DockDrawerPanel" Grid.Row="1" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,6,0,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Pinned Apps List (Clean, borderless, auto-wrapping dynamic responsive grid) -->
                        <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" 
                                      MaxHeight="124" HorizontalAlignment="Center">
                            <ScrollViewer.Resources>
                                <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource ModernMinimalScrollBar}"/>
                            </ScrollViewer.Resources>
                            <ItemsControl x:Name="DockExpandedList" HorizontalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" MaxWidth="416"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="{Binding ItemWidth}" Height="{Binding ItemHeight}" Margin="2.5,2" Background="Transparent" CornerRadius="10"
                                                Cursor="Hand" ToolTip="{Binding Name}" Tag="{Binding}"
                                                PreviewMouseLeftButtonDown="DockItem_PreviewMouseLeftButtonDown"
                                                MouseLeftButtonUp="DockItem_MouseLeftButtonUp"
                                                MouseRightButtonUp="DockItem_MouseRightButtonUp">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#1AFFFFFF"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Grid HorizontalAlignment="Center">
                                                    <Image Source="{Binding IconSource}" Width="{Binding IconSize}" Height="{Binding IconSize}" VerticalAlignment="Top" HorizontalAlignment="Center"/>
                                                    <Ellipse Width="3" Height="3" Fill="#30D158" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                                             Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisConverter}}" Margin="0,0,0,-2.5"/>
                                                </Grid>
                                                <TextBlock Text="{Binding Name}" Foreground="#E5E5EA" FontSize="{Binding FontSize}" FontWeight="SemiBold"
                                                           TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="{Binding ItemWidth}" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Professional Drag & Drop Guide Hint -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                            <TextBlock Text="✦" Foreground="#0A84FF" FontSize="8.5" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="Seret &amp; lepas pintasan aplikasi ke Aia Dinamic untuk menambahkan" 
                                       Foreground="#636366" FontSize="10" FontWeight="Normal" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ==================== 3. FLOATING PINNED LYRICS NOTCH ==================== -->
                <!-- Active when Karaoke mode is enabled/pinned: Sleek Notch Capsule with music note icon & 2-line rolling lyrics -->
                <Grid x:Name="FloatingLyricsView" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="14,0"
                      Background="Transparent"
                      Cursor="Arrow">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Music Note Icon Badge & Dismiss Button (Always visible; morphs to [✕] on hover) -->
                    <Button x:Name="BtnCloseFloatingLyrics" Grid.Column="0" Width="28" Height="28" Margin="0,0,10,0"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Cursor="Hand" Click="BtnCloseFloatingLyrics_Click"
                            ToolTip="Tutup Lirik Mengambang"
                            FocusVisualStyle="{x:Null}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="BadgeBorder" Width="28" Height="28" CornerRadius="14" Background="#1C1C1E"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- Normal State: Green Music Note Icon -->
                                        <Path x:Name="BadgeMusicIcon" Width="13" Height="13" Stretch="Uniform" Fill="#30D158"
                                              Data="M10 4v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V8h8v6.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V4H10z"/>
                                        <!-- Hover State: Crisp White Dismiss [✕] Icon -->
                                        <Path x:Name="BadgeCloseIcon" Width="10" Height="10" Stretch="Uniform" Fill="#FFFFFF" Visibility="Collapsed"
                                              Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BadgeBorder" Property="Background" Value="#3A3A3C"/>
                                        <Setter TargetName="BadgeMusicIcon" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="BadgeCloseIcon" Property="Visibility" Value="Visible"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Center: 2-Line Rolling Lyrics (Symmetrically Centered in the Notch) -->
                    <Grid Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" ClipToBounds="True" Background="Transparent" Cursor="Arrow">
                        <StackPanel x:Name="FloatingLyricsStack" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="Transparent" Cursor="Arrow">
                            <StackPanel.RenderTransform>
                                <TranslateTransform x:Name="FloatingLyricsTranslate" Y="0"/>
                            </StackPanel.RenderTransform>
                            <!-- Active Lyric: 100% Bright White / SemiBold / Centered -->
                            <TextBlock x:Name="TxtFloatingLyricCurrent" Text="Memuat lirik..."
                                       Foreground="#FFFFFF" FontSize="16" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" TextAlignment="Center" HorizontalAlignment="Stretch"
                                       Cursor="Arrow">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
                                </TextBlock.Effect>
                            </TextBlock>
                            <!-- Next Upcoming Lyric: Semi-transparent preview / Centered -->
                            <TextBlock x:Name="TxtFloatingLyricNext" Text=""
                                       Foreground="#E5E5EA" FontSize="12" FontWeight="Normal" Opacity="0.5"
                                       TextTrimming="CharacterEllipsis" TextAlignment="Center" HorizontalAlignment="Stretch" Margin="0,2,0,0"
                                       Cursor="Arrow">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="0" Opacity="0.6"/>
                                </TextBlock.Effect>
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <!-- Right: Invisible Symmetrical Balance Spacer (28px + 10px margin ensures centered lyrics) -->
                    <Border Grid.Column="2" Width="28" Height="28" Margin="10,0,0,0"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Background="Transparent" IsHitTestVisible="False"/>
                </Grid>

                <!-- ==================== 4. VOLUME HUD OVERLAY (WHEN NOTCH IS PEELING / HIDE) ==================== -->
                <!-- Active when user scrolls mouse wheel over the Dynamic Island while in Peek / Hide mode -->
                <Grid x:Name="VolumeOverlayView" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtVolumeIcon" Text="🔊" FontSize="13" Foreground="#FFFFFF" FontFamily="Segoe UI Emoji, Segoe UI Symbol" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Border Width="110" Height="6" CornerRadius="3" Background="#2C2C2E" VerticalAlignment="Center" Margin="0,0,10,0">
                            <Border x:Name="VolumeProgressBar" HorizontalAlignment="Left" Width="55" CornerRadius="3" Background="#FFFFFF"/>
                        </Border>
                        <TextBlock x:Name="TxtVolumePercent" Text="50%" Foreground="#F2F2F7" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- ==================== 5. NOTIFICATION BANNER ==================== -->
                <!-- Active when Windows toast, clipboard, or system alert arrives -->
                <Grid x:Name="NotificationBannerView" Visibility="Collapsed" VerticalAlignment="Center" Margin="14,0" Cursor="Hand" MouseLeftButtonUp="NotificationBanner_Click">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon / Badge -->
                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14" Background="#1C1C1E" Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtNotifIcon" Text="🔔" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <!-- Message Body -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtNotifApp" Text="WINDOWS" Foreground="#30D158" FontSize="9" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtNotifTitle" Text="Notifikasi Baru" Foreground="#F2F2F7" FontSize="12" FontWeight="Bold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtNotifMessage" Text="Isi pesan notifikasi..." Foreground="#8E8E93" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                    </StackPanel>

                    <!-- Dismiss / Close button -->
                    <Border Grid.Column="2" Width="18" Height="18" CornerRadius="9" Background="#2C2C2E" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="✕" Foreground="#8E8E93" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>

            </Grid>
        </Border>
        <!-- ==================== EXTERNAL RIGHT VERTICAL VOLUME HUD (OUTSIDE NOTCH) ==================== -->
        <!-- Sits cleanly outside the right edge of IslandBorder, filling from bottom to top, height matching Notch Besar -->
        <Border x:Name="ExternalRightVolumeHUD"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Width="20" Height="188" CornerRadius="10"
                Background="#1C1C1E" BorderBrush="#38383E" BorderThickness="1"
                Opacity="0" Visibility="Collapsed" IsHitTestVisible="False"
                Panel.ZIndex="1000">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ExternalRightVolumeTransform" X="0" Y="0"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="3" Opacity="0.55"/>
            </Border.Effect>
            <Grid Margin="0,8,0,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- Volume % at Top -->
                <TextBlock x:Name="TxtExternalVolumePercent" Grid.Row="0" Text="75%" FontSize="8" FontWeight="Bold"
                           Foreground="#A1A1A6" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,0,0,4"/>

                <!-- Vertical Track Background (Slim 4px track) -->
                <Border x:Name="ExternalVolumeTrack" Grid.Row="1" Width="4"
                        CornerRadius="2" Background="#2C2C30" HorizontalAlignment="Center">
                    <!-- Bottom-to-Top Fill Bar -->
                    <Border x:Name="ExternalVolumeFill" Width="4" Height="40"
                            CornerRadius="2" Background="#FFFFFF"
                            VerticalAlignment="Bottom" HorizontalAlignment="Stretch"/>
                </Border>
                <!-- Speaker Icon at Bottom (Crisp bright white) -->
                <TextBlock x:Name="TxtExternalVolumeIcon" Grid.Row="2" Text="🔊" FontSize="10"
                           Foreground="#FFFFFF" FontFamily="Segoe UI Emoji, Segoe UI Symbol"
                           HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,4,0,0"/>
            </Grid>
        </Border>
        <!-- ==================== EXTERNAL BOTTOM HORIZONTAL VOLUME HUD (UNDER NOTCH KECIL) ==================== -->
        <!-- Sits cleanly directly underneath Notch Kecil, length/width matching Notch Kecil, slim 4px track -->
        <Border x:Name="BottomVolumeHUD"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Width="188" Height="40" CornerRadius="20"
                Background="#1C1C1E" BorderBrush="#38383E" BorderThickness="1"
                Opacity="0" Visibility="Collapsed" IsHitTestVisible="False"
                Panel.ZIndex="1000">
            <Border.RenderTransform>
                <TranslateTransform x:Name="BottomVolumeTransform" X="0" Y="48"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Opacity="0.6"/>
            </Border.Effect>
            <Grid Margin="12,0,12,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Speaker Icon (Crisp bright white) -->
                <TextBlock x:Name="TxtBottomVolumeIcon" Grid.Column="0" Text="🔊" FontSize="11.5"
                           Foreground="#FFFFFF" FontFamily="Segoe UI Emoji, Segoe UI Symbol"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <!-- Slim Horizontal Track (4px) -->
                <Border x:Name="BottomVolumeTrack" Grid.Column="1" Height="4" CornerRadius="2"
                        Background="#2C2C30" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="0,0,8,0">
                    <Border x:Name="BottomVolumeProgressBar" HorizontalAlignment="Left" Width="55" Height="4"
                            CornerRadius="2" Background="#FFFFFF"/>
                </Border>
                <!-- Volume % at Right -->
                <TextBlock x:Name="TxtBottomVolumePercent" Grid.Column="2" Text="50%"
                           Foreground="#F2F2F7" FontSize="11" FontWeight="SemiBold"
                           VerticalAlignment="Center" HorizontalAlignment="Right" MinWidth="26" TextAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>
