                                        <Slider x:Name="SliderEq1" Style="{StaticResource EqVerticalSlider}" Height="66" Minimum="-12" Maximum="12" Value="0" Tag="1" ValueChanged="SliderEq_ValueChanged"/>
                                        <TextBlock Text="63" FontSize="9" FontWeight="SemiBold" Foreground="#A1A1A6" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <!-- Band 2: 125 Hz -->
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                        <TextBlock x:Name="TxtEqDb2" Text="0" FontSize="8.5" Foreground="#8E8E93" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                        <Slider x:Name="SliderEq2" Style="{StaticResource EqVerticalSlider}" Height="66" Minimum="-12" Maximum="12" Value="0" Tag="2" ValueChanged="SliderEq_ValueChanged"/>
                                        <TextBlock Text="125" FontSize="9" FontWeight="SemiBold" Foreground="#A1A1A6" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <!-- Band 3: 250 Hz -->
                                    <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                        <TextBlock x:Name="TxtEqDb3" Text="0" FontSize="8.5" Foreground="#8E8E93" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                        <Slider x:Name="SliderEq3" Style="{StaticResource EqVerticalSlider}" Height="66" Minimum="-12" Maximum="12" Value="0" Tag="3" ValueChanged="SliderEq_ValueChanged"/>
                                        <TextBlock Text="250" FontSize="9" FontWeight="SemiBold" Foreground="#A1A1A6" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <!-- Band 4: 500 Hz -->
                                    <StackPanel Grid.Column="4" HorizontalAlignment="Center">
